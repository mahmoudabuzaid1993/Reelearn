# Copy to api/.env for local development. Every value here has a working default for docker-compose.

APP_ENV=development                 # development | test | production (development: OTP code is 1234 and is logged, fake AI providers)
PORT=8080
PUBLIC_BASE_URL=http://localhost:3000   # used in invite and review links
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://reelearn:reelearn@localhost:5432/reelearn
DATABASE_MAX_CONNECTIONS=16
# DB_APP_ROLE=reelearn_app          # role tenant transactions drop into (created by migration 0002); set empty to disable

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000   # RustFS / MinIO / S3
S3_PUBLIC_ENDPOINT=http://localhost:9000   # what phones and browsers can reach (CDN in production)
S3_BUCKET=reelearn
S3_REGION=us-east-1
S3_ACCESS_KEY=reelearn
S3_SECRET_KEY=reelearn123

JWT_ALGORITHM=HS256                 # HS256 (JWT_SECRET) or RS256 (JWT_PRIVATE_PEM / JWT_PUBLIC_PEM)
JWT_SECRET=change-me-change-me-change-me-32-chars
JWT_ISSUER=reelearn
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=3

# 32-byte hex key for AES-GCM encryption of per-tenant integration secrets (generate: openssl rand -hex 32)
# SECRETS_KEY=

# Webhook signatures (required outside development)
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# PROVIDER_WEBHOOK_SECRET=

# ---- worker ------------------------------------------------------------
# PROVIDERS=real                    # default: fake in development/test, real in production
# WORKER_CONCURRENCY=4
# WORKER_SCHEDULER=true
# Meta Model API (Muse): the default brain when MODEL_API_KEY is set. Key from dev.meta.ai.
#   Muse Spark writes scripts/questions/translations/moments, Muse Image makes 9:16 keyframes
#   (ffmpeg turns them into video), Muse Voice Transcribe transcribes podcasts (WAV; ffmpeg converts).
# MODEL_API_KEY=
# MUSE_MODEL=muse-spark-1.3         # or muse-spark-1.3-contributor (cheaper)
# MUSE_BASE_URL=https://api.meta.ai/v1
# WRITER_PROVIDER=muse              # muse | claude (when both keys are set)
# ANTHROPIC_API_KEY=                # Claude alternative for extraction, scripts, questions, translation, moments
# CLAUDE_MODEL=claude-sonnet-5-5
# VIDEO_API_URL=  VIDEO_API_KEY=  VIDEO_PROVIDER=higgsfield   # async render vendor (see crates/worker/src/providers/real.rs)
# VOICE_API_URL=  VOICE_API_KEY=
# ASR_API_URL=    ASR_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=  WHATSAPP_ACCESS_TOKEN=            # WhatsApp Business Cloud API
